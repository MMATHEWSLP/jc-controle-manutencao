{
  "name": "manutencao-preventiva",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:reconciliation": "esbuild tests/maintenance-reconciliation.integration.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-reconciliation.mjs && node --test /tmp/manutencao-preventiva-reconciliation.mjs",
    "test:front-scope": "esbuild tests/front-scope.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-front-scope.mjs && node --test /tmp/manutencao-preventiva-front-scope.mjs",
    "test:history-rules": "esbuild tests/maintenance-history-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-history-rules.mjs && node --test /tmp/manutencao-preventiva-history-rules.mjs",
    "test:equipment-health-summary": "esbuild tests/equipment-health-summary.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-equipment-health-summary.mjs && node --test /tmp/manutencao-preventiva-equipment-health-summary.mjs",
    "test:import-equipamentos": "node --test tests/import-equipamentos.test.mjs",
    "test:generic-date-correction": "node --test tests/generic-date-correction.test.mjs",
    "test:db-sql": "esbuild tests/db-sql-translation.test.mjs --bundle --platform=node --format=esm --packages=external --outfile=tests/.tmp-db-sql-translation.mjs && node --test tests/.tmp-db-sql-translation.mjs",
    "test:pg-parameter-safety": "node --test tests/pg-parameter-type-safety.test.mjs",
    "test:task-authorization": "esbuild tests/task-authorization.test.mjs --bundle --platform=node --format=esm --packages=external --outfile=tests/.tmp-task-authorization.mjs && node --test tests/.tmp-task-authorization.mjs",
    "test:products-import": "esbuild tests/products-import.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-products-import.mjs && node --test /tmp/manutencao-preventiva-products-import.mjs",
    "test:equipment-sort": "esbuild tests/equipment-sort.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-equipment-sort.mjs && node --test /tmp/manutencao-preventiva-equipment-sort.mjs",
    "test:import-trocas-oleo": "node --test tests/import-trocas-oleo.test.mjs",
    "test:daily-record-rules": "esbuild tests/daily-record-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-daily-record-rules.mjs && node --test /tmp/manutencao-preventiva-daily-record-rules.mjs",
    "test": "node scripts/run-tests.mjs",
    "import:equipamentos": "node importar-equipamentos.mjs",
    "import:equipamentos:confirmar": "node importar-equipamentos.mjs --confirmar",
    "import:equipamentos:recalcular": "node importar-equipamentos.mjs --recalcular",
    "import:trocas-oleo": "node importar-trocas-oleo.mjs",
    "import:trocas-oleo:confirmar": "node importar-trocas-oleo.mjs --confirmar",
    "test:daily-history-rules": "esbuild tests/daily-history-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-daily-history-rules.mjs && node --test /tmp/manutencao-preventiva-daily-history-rules.mjs",
    "test:product-rules": "esbuild tests/product-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-product-rules.mjs && node --test /tmp/manutencao-preventiva-product-rules.mjs",
    "test:fuel-rules": "esbuild tests/fuel-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-fuel-rules.mjs && node --test /tmp/manutencao-preventiva-fuel-rules.mjs",
    "test:employee-rules": "esbuild tests/employee-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-employee-rules.mjs && node --test /tmp/manutencao-preventiva-employee-rules.mjs",
    "test:leave-cycle": "esbuild tests/leave-cycle.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-leave-cycle.mjs && node --test /tmp/manutencao-preventiva-leave-cycle.mjs",
    "test:registry-fronts": "esbuild tests/registry-fronts.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-registry-fronts.mjs && node --test /tmp/manutencao-preventiva-registry-fronts.mjs",
    "test:stock": "tsx --test tests/stock-service.integration.test.mjs",
    "test:purchase-rules": "esbuild tests/purchase-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-purchase-rules.mjs && node --test /tmp/manutencao-preventiva-purchase-rules.mjs",
    "test:import-abastecimento": "node --test tests/import-abastecimento.test.mjs",
    "import:abastecimento": "node importar-abastecimento.mjs",
    "import:abastecimento:confirmar": "node importar-abastecimento.mjs --confirmar",
    "test:third-party-rules": "esbuild tests/third-party-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-third-party-rules.mjs && node --test /tmp/manutencao-preventiva-third-party-rules.mjs",
    "test:local-datetime": "esbuild tests/local-datetime.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-local-datetime.mjs && node --test /tmp/manutencao-preventiva-local-datetime.mjs",
    "test:date-format": "esbuild tests/date-format.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-date-format.mjs && TZ=America/Sao_Paulo node --test /tmp/manutencao-preventiva-date-format.mjs",
    "test:fleet-costs": "esbuild tests/fleet-costs.test.mjs --bundle --platform=node --format=esm --packages=external --outfile=tests/.tmp-fleet-costs.mjs && node --test tests/.tmp-fleet-costs.mjs",
    "test:fuel-tank-rules": "esbuild tests/fuel-tank-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-fuel-tank-rules.mjs && node --test /tmp/manutencao-preventiva-fuel-tank-rules.mjs",
    "test:checklist-rules": "esbuild tests/checklist-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-checklist-rules.mjs && node --test /tmp/manutencao-preventiva-checklist-rules.mjs",
    "test:component-rules": "esbuild tests/component-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-component-rules.mjs && node --test /tmp/manutencao-preventiva-component-rules.mjs",
    "test:weekly-report-rules": "esbuild tests/weekly-report-rules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/manutencao-preventiva-weekly-report-rules.mjs && node --test /tmp/manutencao-preventiva-weekly-report-rules.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "next": "^16.3.7",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.7",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Controle de Manutenção Preventiva",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
